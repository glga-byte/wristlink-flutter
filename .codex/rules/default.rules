prefix_rule(pattern=["adb", "devices"], decision="allow")
prefix_rule(pattern=["dart", "format"], decision="allow")
prefix_rule(pattern=["dart", "run", "tool/android_gradle.dart"], decision="allow", justification="Allow all Android Gradle tasks through the WristLink JDK-aware launcher")
prefix_rule(pattern=["flutter", "analyze"], decision="allow")
prefix_rule(pattern=["flutter", "build", "apk"], decision="allow")
prefix_rule(pattern=["flutter", "build", "ios"], decision="allow")
prefix_rule(pattern=["flutter", "test"], decision="allow")
prefix_rule(pattern=["xcodebuild", "test"], decision="allow", justification="Allow Xcode test actions")
prefix_rule(pattern=["xcodebuild", "-list"], decision="allow", justification="Allow listing Xcode workspace metadata")
prefix_rule(pattern=["xcodebuild", "-workspace", "Runner.xcworkspace", "-list"], decision="allow", justification="Allow listing WristLink Xcode workspace metadata")
prefix_rule(pattern=["xcrun", "simctl", "list", "devices", "available"], decision="allow", justification="Allow listing available Apple simulators")
